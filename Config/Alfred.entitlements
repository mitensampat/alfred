<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow loading dynamic libraries not signed with the same Team ID.
         Swift runtime + 3rd-party C libs (e.g. SQLite system lib) require this. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow JIT (some Swift dispatch + dynamic codegen paths). Safe default. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
